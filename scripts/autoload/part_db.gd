extends Node
## Mech part definitions. data/parts.json is generated by the Blender pipeline
## (tools/blender/build_mech.py), so stats live next to the models that use them.

const DATA_PATH := "res://data/parts.json"

var parts: Dictionary = {}


func _ready() -> void:
    var text := FileAccess.get_file_as_string(DATA_PATH)
    var data = JSON.parse_string(text)
    if data is Dictionary:
        parts = data.get("parts", {})
    else:
        push_error("PartDB: could not read %s - run tools/blender/build_all.sh" % DATA_PATH)


func has_part(id: String) -> bool:
    return parts.has(id)


func get_part(id: String) -> Dictionary:
    return parts.get(id, {})


func stat(id: String, key: String, default = 0):
    return get_part(id).get(key, default)


func display_name(id: String) -> String:
    return str(get_part(id).get("name", id))


func fits(id: String, slot: String) -> bool:
    var s := str(get_part(id).get("slot", ""))
    return s == slot or (s == "weapon" and slot.begins_with("weapon_"))


func sorted_ids() -> Array:
    var ids := parts.keys()
    ids.sort()
    return ids


func summary(id: String) -> String:
    var p := get_part(id)
    var bits := ["HP %d" % int(p.get("hp", 0)), "%d kg" % int(p.get("mass_kg", 0))]
    for key in ["damage", "fire_rate", "range", "speed", "jump", "power", "fuel"]:
        if p.has(key):
            bits.append("%s %s" % [key.replace("_", " "), str(p[key])])
    return "  ".join(bits)


func instantiate(id: String) -> Node3D:
    var path := str(get_part(id).get("scene", ""))
    if path == "" or not ResourceLoader.exists(path):
        push_error("PartDB: no scene for part '%s'" % id)
        return null
    var packed: PackedScene = load(path)
    return packed.instantiate() as Node3D
